# OnCurve settings. Copy this file to .env, or let `npm run setup` create .env for you.
# .env holds secrets and is never committed; this example file only lists the names.

# Random secret used to protect sign-in sessions. `npm run setup` fills it in for you.
SESSION_SECRET=

# Optional: key for the assistant's AI mode. Leave it empty to use the offline helper,
# which needs no key and no internet. Never paste the key anywhere else.
ANTHROPIC_API_KEY=

# Optional: port of the local web server (default 3000).
PORT=
