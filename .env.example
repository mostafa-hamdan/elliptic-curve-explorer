# OnCurve settings. Copy this file to .env, or let `npm run setup` create .env for you.
# .env holds secrets and is never committed; this example file only lists the names.

# Random secret used to protect sign-in sessions. `npm run setup` fills it in for you.
SESSION_SECRET=

# Optional: the assistant's AI mode. Without a key for the chosen provider the assistant
# uses its offline helper, which needs no key and no internet. Keys stay in this file:
# never paste one anywhere else.
#
# Who receives the questions: "openai" (the default) or "anthropic". Only this provider is
# ever contacted, even if a key for the other one is also set.
AI_PROVIDER=openai

# Used when AI_PROVIDER=openai. The app only calls POST https://api.openai.com/v1/responses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# How hard the model thinks: a value the model accepts, such as none, low or medium, or
# "default" to leave it to the model. A value the model refuses is dropped automatically.
OPENAI_REASONING_EFFORT=low

# Used when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# AI questions allowed per day across all users (the day ends at midnight UTC). After
# that everyone gets the offline helper until the next day. 0 turns AI mode off.
AI_DAILY_LIMIT=50

# Only on a hosted copy served over HTTPS (for example Vercel): set to 1 for secure cookies,
# HSTS, the visitor address from Vercel, and a demo account visitors cannot change.
HOSTED=

# Optional: port of the local web server (default 3000).
PORT=

# Optional: database address. Empty means the local file data/oncurve.db.
# A hosted Turso database looks like libsql://name.turso.io and needs DATABASE_AUTH_TOKEN.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Optional: limits per network address (defaults: 10 new accounts per hour, 30 sign-in
# attempts per 15 minutes). The automated browser tests raise them.
SIGNUPS_PER_HOUR=
SIGNINS_PER_IP=
